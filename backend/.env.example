# ==============================================================================
# StayHive — Backend Production & Staging Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with secret values.
# NEVER commit the active '.env' file to version control.

# --- Django Core Settings ---
DJANGO_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-with-50-chars!
DJANGO_DEBUG=False
ALLOWED_HOSTS=stayhive.com,api.stayhive.com,localhost,127.0.0.1

# --- CORS & CSRF Origins ---
CORS_ALLOWED_ORIGINS=https://stayhive.com,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://stayhive.com,https://api.stayhive.com,http://localhost:5173

# --- MySQL Database Configuration ---
DB_NAME=stayhive
DB_USER=stayhive_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Production Security & HTTPS Headers (Set to True in production) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- JWT Authentication Settings ---
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- DRF Rate Limiting / Throttling ---
THROTTLE_ANON_RATE=100/min
THROTTLE_USER_RATE=1000/min
THROTTLE_AUTH_RATE=20/min
THROTTLE_BURST_RATE=60/min
